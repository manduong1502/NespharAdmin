# ==============================================================================
# CẤU HÌNH MÔI TRƯỜNG PRODUCTION — UBUNTU MINI SERVER bonix-p330 (NESPHAR)
# Sao chép file này thành `.env` trên server trước khi chạy `sudo bash deploy.sh`
# ==============================================================================

# Cổng host trên server bonix-p330 (4005 tránh đụng Chat 5000/5001 và Delivery 4002/4003)
# Trỏ Cloudflare Tunnel route (VD: nesphar.bonix.site) -> HTTP://localhost:4005
PORT=4005

# Bảo mật: 127.0.0.1 để chỉ nhận lưu lượng qua Cloudflare Tunnel nội bộ
HOST_BIND_IP=127.0.0.1

# Khóa bí mật ký JWT đăng nhập Web Admin (BẮT BUỘC chuỗi ngẫu nhiên >= 32 ký tự)
JWT_SECRET=nesphar-change-this-secret-in-production-2026

# Khóa bí mật ứng dụng Zalo (developers.zalo.me -> App 4490716441165809191)
ZALO_APP_SECRET=

# Đặt false khi đã điền ZALO_APP_SECRET để bắt buộc xác thực SĐT thật từ máy chủ Zalo
ALLOW_SIMULATOR_PHONE_FALLBACK=true

# Tắt tự chuyển hạng B2B demo trên Mini App khi chạy Production thực tế
ALLOW_DEMO_TIER_SWITCH=false

# Khóa bảo mật Webhook tự động gạch nợ ngân hàng VietQR (SePay / Casso)
PAYMENT_WEBHOOK_SECRET=

# Cảnh báo đơn mới qua Telegram Bot (Có thể chỉnh trực tiếp trên Web Admin)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
OUTBOUND_WEBHOOK_URL=

# Danh sách tên miền Web Admin cho phép gọi CORS (Zalo *.zdn.vn / *.zalo.me đã tự động cho phép)
CORS_ORIGINS=https://nesphar.bonix.site
