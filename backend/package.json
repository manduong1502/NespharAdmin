{
  "name": "nesphar-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API, Pharmacy FEFO Inventory, CRM/CMS & Static Server for NESPHAR Zalo Mini App + Web Admin",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node --no-warnings dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "reset:golive": "node --no-warnings scripts/reset-golive.cjs"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
